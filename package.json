{
  "name": "@stevensmex05/ts-api-client",
  "version": "0.1.0",
  "description": "Reusable TypeScript API client with Axios, auth refresh, retry, normalized errors and CRUD helpers.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "npm run typecheck && npm run test && npm run build",
    "prepack": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "axios",
    "api-client",
    "typescript",
    "react",
    "jwt",
    "crud",
    "retry"
  ],
  "author": "Steven Ritchie Rakotonindraina",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^4.1.9",
    "axios-mock-adapter": "^2.1.0",
    "jsdom": "^27.4.0",
    "tsdown": "^0.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
